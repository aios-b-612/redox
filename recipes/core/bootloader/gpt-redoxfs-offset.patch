+/// Last boot stage, overwritten on the ESP. A hang leaves the last line in
+/// `\aios-stage.txt` because the bootloader never writes RedoxFS.
+pub fn stage(msg: &str) {
+    println!("AIOS: stage {}", msg);
+    let esp_handle = match LoadedImage::handle_protocol(std::handle()) {
+        Ok(loaded) => loaded.0.DeviceHandle,
+        Err(_) => return,
+    };
+    let mut esp_fs = match FileSystem::handle_protocol(esp_handle) {
+        Ok(fs) => fs,
+        Err(_) => return,
+    };
+    let mut root = match esp_fs.root() {
+        Ok(root) => root,
+        Err(_) => return,
+    };
+    let name = [
+        b'\\' as u16,
+        b'a' as u16,
+        b'i' as u16,
+        b'o' as u16,
+        b's' as u16,
+        b'-' as u16,
+        b's' as u16,
+        b't' as u16,
+        b'a' as u16,
+        b'g' as u16,
+        b'e' as u16,
+        b'.' as u16,
+        b't' as u16,
+        b'x' as u16,
+        b't' as u16,
+        0,
+    ];
+    let mut interface = core::ptr::null_mut();
+    let status = (root.0.0.Open)(
+        root.0.0,
+        &mut interface,
+        name.as_ptr(),
+        uefi::fs::FILE_MODE_READ | uefi::fs::FILE_MODE_WRITE | uefi::fs::FILE_MODE_CREATE,
+        0,
+    );
+    if !status.is_success() || interface.is_null() {
+        return;
+    }
+    let mut file = uefi_std::fs::File(unsafe { &mut *interface });
+    let _ = (file.0.SetPosition)(file.0, 0);
+    let mut line = [b' '; 32];
+    let bytes = msg.as_bytes();
+    let n = bytes.len().min(31);
+    line[..n].copy_from_slice(&bytes[..n]);
+    line[31] = b'\n';
+    let _ = file.write(&line);
+    let _ = (file.0.Flush)(file.0);
+}
+
+/// Byte offset of the REDOX partition when the firmware only publishes the
+/// whole disk. A fixed 2 MiB misses the Pi image: the ESP is 128 MiB and
+/// RedoxFS starts at LBA 264192. Without the real start, open fails and the
+/// screen stops at "No RedoxFS partitions found" before the root is mounted.
+fn redoxfs_offset_from_gpt(disk: &mut DiskEfi) -> u64 {
+    const FALLBACK: u64 = 2 * crate::MIBI as u64;
+    // On-disk mixed-endian type GUID of the REDOX GPT entry.
+    const REDOX_TYPE: [u8; 16] = [
+        0xaf, 0x3d, 0xc6, 0x0f, 0x83, 0x84, 0x72, 0x47, 0x8e, 0x79, 0x3d, 0x69, 0xd8, 0x47, 0x7d,
+        0xe4,
+    ];
+
+    let block_size = disk.0.Media.BlockSize as usize;
+    if block_size < 512 || block_size > 4096 || !block_size.is_power_of_two() {
+        return FALLBACK;
+    }
+
+    let header = unsafe {
+        let ptr = super::alloc_zeroed_page_aligned(block_size);
+        if ptr.is_null() {
+            return FALLBACK;
+        }
+        slice::from_raw_parts_mut(ptr, block_size)
+    };
+    stage("gpt-header");
+    let status = unsafe {
+        (disk.0.ReadBlocks)(
+            disk.0,
+            disk.0.Media.MediaId,
+            1,
+            block_size,
+            header.as_mut_ptr(),
+        )
+    };
+    if !status.is_success() || header.len() < 92 || &header[..8] != b"EFI PART" {
+        stage("gpt-header-fail");
+        return FALLBACK;
+    }
+
+    let entry_lba = u64::from_le_bytes(header[72..80].try_into().unwrap());
+    let nentries = u32::from_le_bytes(header[80..84].try_into().unwrap()) as usize;
+    let entsz = u32::from_le_bytes(header[84..88].try_into().unwrap()) as usize;
+    if entsz < 48 || nentries == 0 || nentries > 128 || entsz > block_size {
+        stage("gpt-header-bad");
+        return FALLBACK;
+    }
+
+    // One media block per ReadBlocks. A 16 KiB read of the whole entry array
+    // can fail on the Pi firmware and fall back to the 2 MiB offset.
+    stage("gpt-scan");
+    let nblocks = (nentries * entsz).div_ceil(block_size);
+    for b in 0..nblocks {
+        let status = unsafe {
+            (disk.0.ReadBlocks)(
+                disk.0,
+                disk.0.Media.MediaId,
+                entry_lba + b as u64,
+                block_size,
+                header.as_mut_ptr(),
+            )
+        };
+        if !status.is_success() {
+            stage("gpt-read-fail");
+            return FALLBACK;
+        }
+        let mut off = 0;
+        while off + entsz <= block_size {
+            let index = (b * block_size + off) / entsz;
+            if index >= nentries {
+                break;
+            }
+            let e = &header[off..off + 48];
+            off += entsz;
+            if e[..16] != REDOX_TYPE {
+                continue;
+            }
+            let start_lba = u64::from_le_bytes(e[32..40].try_into().unwrap());
+            let offset = start_lba.saturating_mul(block_size as u64);
+            println!("AIOS: RedoxFS GPT LBA {} offset {}", start_lba, offset);
+            stage("gpt-ok");
+            return offset;
+        }
+    }
+
+    println!("AIOS: no REDOX GPT entry, fallback {} bytes", FALLBACK);
+    stage("gpt-missing");
+    FALLBACK
+}
