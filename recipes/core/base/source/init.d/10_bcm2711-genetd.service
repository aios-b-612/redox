[unit]
description = "BCM2711 GENET Ethernet driver (Raspberry Pi 4)"
requires_weak = [
    "00_base.target",
]

[service]
# init PATH is only $prefix/bin — the binary lives under /usr/lib/drivers
# (same layout as pcid-spawner). Absolute path required or the unit never starts.
cmd = "/usr/lib/drivers/bcm2711-genetd"
# notify: init espera daemon.ready() (após network.genet), para o netstack
# não expirar o retry de 10s à procura de /scheme/network*.
type = "notify"
