[unit]
description = "BCM2711 GENET Ethernet driver (Raspberry Pi 4)"
requires_weak = [
    "00_base.target",
]

[service]
# Absolute path — init PATH is only $prefix/bin.
cmd = "/usr/lib/drivers/bcm2711-genetd"
# oneshot_async: do not block boot if MDIO/init is slow (notify waited on ready).
type = "oneshot_async"
